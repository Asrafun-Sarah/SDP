# Copy this file to .env and fill in your real values.
# Never commit the real .env file.

# Port the app runs on locally
PORT=3000

# Supabase Postgres connection string
# Find this in Supabase: Project Settings > Database > Connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# A random long string used to sign login sessions
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_this_with_a_random_string

# Cloudinary credentials (find these on your Cloudinary dashboard)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
